{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env.local vite dev --port 3000",
    "build": "bun --env-file=../../.env.local vite build",
    "preview": "bun --env-file=../../.env.local vite preview",
    "test": "bun --env-file=../../.env.local vitest run",
