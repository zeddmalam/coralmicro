{
  "name": "monitoring",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "next-themes": "^0.4.6",
      "@trpc/server": "^11.16.0",
      "@trpc/client": "^11.16.0",
      "better-auth": "1.5.5",
      "@polar-sh/better-auth": "^1.8.3",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:api": "turbo -F api dev",
    "db:push": "turbo -F @monitoring/db db:push",
    "db:studio": "turbo -F @monitoring/db db:studio",
    "db:generate": "turbo -F @monitoring/db db:generate",
    "db:migrate": "turbo -F @monitoring/db db:migrate",
    "db:start": "turbo -F @monitoring/db db:start",
    "db:watch": "turbo -F @monitoring/db db:watch",
    "db:stop": "turbo -F @monitoring/db db:stop",
    "db:down": "turbo -F @monitoring/db db:down"
  },
  "dependencies": {
    "@monitoring/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@monitoring/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
